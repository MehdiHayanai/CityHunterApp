# Server-side only - never exposed to client
# This key is injected by the Next.js API proxy route
API_BASE_KEY="your_api_key_here"

# Backend API URL (optional, defaults to /api/backend for proxy)
# NEXT_PUBLIC_API_URL="/api/backend"

# For local development, point to your backend server
# This is used by the Next.js proxy to forward requests
BACKEND_API_URL="http://127.0.0.1:8000/api/v1"
